# Aura local environment — copy to `.env` and adjust.
# docker compose and Spring/Python services read these (or matching shell exports).

# --- PostgreSQL ---
AURA_DB_NAME=aura
AURA_DB_USER=aura
AURA_DB_PASSWORD=aura
AURA_DB_PORT=5432
AURA_DB_URL=jdbc:postgresql://localhost:5432/aura

# --- Redis ---
AURA_REDIS_PORT=6379
# VTON Celery (override if Redis is remote)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- MinIO / S3 ---
AURA_MINIO_API_PORT=9000
AURA_MINIO_CONSOLE_PORT=9001
AURA_STORAGE_PROVIDER=s3
AURA_S3_ENDPOINT=http://127.0.0.1:9000
AURA_S3_PUBLIC_BASE_URL=http://127.0.0.1:9000
AURA_S3_REGION=us-east-1
AURA_S3_ACCESS_KEY=aura_minio
AURA_S3_SECRET_KEY=aura_minio_secret
AURA_S3_PATH_STYLE=true
AURA_S3_WARDROBE_BUCKET=aura-wardrobe
AURA_S3_VTON_BUCKET=aura-vton
AURA_S3_AVATARS_BUCKET=aura-avatars
# R2 dashboard > bucket > Settings > Public Development URL > Enable.
# Gorunen Public Bucket URL (https://pub-....r2.dev). Bucket adi hostta yoktur.
# AURA_S3_WARDROBE_PUBLIC_HOST=
# AURA_S3_VTON_PUBLIC_HOST=
# AURA_S3_AVATARS_PUBLIC_HOST=
AURA_S3_UPLOAD_TTL=900

# --- Backend ---
AURA_BACKEND_PORT=8080
AURA_JWT_SECRET=aura-dev-jwt-secret-change-me-32chars!!
AURA_JWT_EXPIRATION_MINUTES=15
AURA_JWT_ISSUER=aura-backend

# --- Vision ---
AURA_VISION_URL=http://127.0.0.1:8000
AURA_VISION_NORMALIZE=true
AURA_VISION_CONNECT_TIMEOUT=5
AURA_VISION_READ_TIMEOUT=60

# --- VTON (backend → worker) ---
AURA_VTON_MOCK=false
AURA_VTON_PROVIDER=local
AURA_VTON_WORKER_URL=http://127.0.0.1:8001
AURA_VTON_CONNECT_TIMEOUT=10
AURA_VTON_INFERENCE_TIMEOUT=90
AURA_VTON_COLD_START_ALLOWANCE=30
AURA_VTON_READ_TIMEOUT=0
AURA_VTON_STATUS_TIMEOUT=30
AURA_VTON_COLD_RETRY=true
AURA_VTON_COLD_RETRY_MS=2000
AURA_VTON_DAILY_LIMIT=5
# RunPod (optional): AURA_VTON_PROVIDER=runpod
# AURA_VTON_WORKER_URL=https://api.runpod.ai/v2/<ENDPOINT_ID>
# AURA_RUNPOD_API_KEY=

# --- VTON worker process (export in the Celery/uvicorn shell) ---
# AURA_VTON_MOCK_MODEL=true
# PYTORCH_ENABLE_MPS_FALLBACK=1
# PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0
# HF_HUB_DISABLE_XET=1

# --- Chat / weather (optional) ---
AURA_OLLAMA_URL=http://127.0.0.1:11434
AURA_OLLAMA_MODEL=llama3.2
AURA_CHAT_FALLBACK=true
AURA_WEATHER_LIVE=true
AURA_WEATHER_LAT=41.0082
AURA_WEATHER_LON=28.9784
AURA_WEATHER_LOCATION=Istanbul
