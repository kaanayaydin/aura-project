# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
develop-eggs/
dist/
# downloads/: distutils cache + dump dirs. Intentional everywhere —
# a nested downloads/ is never source we want committed.
downloads/
eggs/
.eggs/
# Python distutils output at repo root only.
# Unanchored `lib/` also matched Flutter `aura-mobile/lib/` and hid Dart sources.
/lib/
/lib64/
# setuptools/buildout artifact at repo root only (same class as /lib/).
/parts/
sdist/
# setuptools var/ at repo root only — lib/var/ would be legitimate source.
/var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
*.env
config.local.json

# Model weights, datasets & heavy binaries
*.pth
*.pt
*.safetensors
*.bin
*.onnx
!**/rotnet_v1.onnx
checkpoints/
/models/
aura-vision/models/
aura-vton/models/
# User/pipeline blobs. Intentional everywhere: nested uploads/outputs/results
# are never Dart/Java source we want committed.
uploads/
outputs/
results/
# Generic name — root + known dataset dirs only. Do not hide lib/data/.
/data/
aura-vision/data/
aura-vton/data/
*.log

# Operating System & IDE artifacts
.DS_Store
Thumbs.db
*.ses
.idea/
.vscode/
*.swp
*.swo
# Virtual Environments
**/.venv/
**/venv/

# Vision orientation debug artifacts (Adim 1)
**/debug_output/

# Build artifacts
# build/: intentional everywhere (Flutter, Maven, Python). Nested lib/build/
# is never source; unanchored on purpose.
**/target/
build/
dist/
*.class
*.jar
